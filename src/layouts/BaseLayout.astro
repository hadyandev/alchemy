---
const { title } = Astro.props;
---
<html lang="en" class="bg-slate-950 text-slate-200">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | Alchemist Library</title>
	</head>
	<body class="max-w-4xl mx-auto px-4 py-8">
		<nav class="flex justify-between items-center mb-12 border-b border-slate-800 pb-6">
			<div class="text-2xl font-bold text-blue-400">💠 Al-Z & Master</div>
			<div class="space-x-6 text-sm">
				<a href="/" class="hover:text-blue-400">Home</a>
				<a href="/techventure" class="hover:text-blue-400">Techventure</a>
				<a href="/story-mode" class="hover:text-blue-400">Story Mode</a>
				<a href="/grimoire" class="hover:text-blue-400">Public Grimoire</a>
			</div>
		</nav>
		<slot />
		<footer class="mt-20 pt-8 border-t border-slate-800 text-center text-slate-500 text-xs">
			Equivalent Exchange &copy; 2026 | Built by Al-Z
		</footer>
	</body>
</html>

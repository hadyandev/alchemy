---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Coming Soon">
	<div class="flex flex-col items-center justify-center min-h-[60vh] text-center w-full">
		<div class="text-8xl mb-8 animate-pulse text-blue-500">⚗️</div>
		<h1 class="text-5xl font-extrabold mb-6 bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">The Library Alchemist</h1>
		<p class="text-slate-400 text-xl italic max-w-md mx-auto">
			"Ilmu adalah buruan dan tulisan adalah ikatannya." — Imam Syafi'i
		</p>
		<div class="mt-12 inline-block px-8 py-3 bg-slate-900 border border-slate-800 rounded-xl">
			<span class="text-blue-400 text-sm font-mono uppercase tracking-widest">Transmutation in Progress...</span>
			<div class="mt-4 h-1 w-full bg-slate-800 rounded-full overflow-hidden">
				<div class="h-full bg-blue-500 w-1/3 animate-progress"></div>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	@keyframes progress {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(250%); }
	}
	.animate-progress {
		animation: progress 2s infinite linear;
	}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Coming Soon">
	<div class="flex flex-col items-center justify-center min-h-[70vh] text-center w-full">
		<div class="text-8xl mb-8 animate-pulse text-blue-500">⚗️</div>
		<h1 class="text-6xl font-black mb-6 bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-500 bg-clip-text text-transparent">
			The Library Alchemist
		</h1>
		<p class="text-slate-600 dark:text-slate-400 text-xl italic max-w-md mx-auto leading-relaxed">
			"Ilmu adalah buruan dan tulisan adalah ikatannya."
		</p>
		
		<div class="mt-12 inline-block px-10 py-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl">
			<span class="text-blue-600 dark:text-blue-400 text-xs font-black uppercase tracking-[0.4em]">Transmutation in Progress</span>
			<div class="mt-6 h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
				<div class="h-full bg-gradient-to-r from-blue-500 to-purple-500 w-1/3 animate-progress"></div>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	@keyframes progress {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(300%); }
	}
	.animate-progress {
		animation: progress 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
	}
</style>

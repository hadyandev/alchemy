---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Coming Soon">
	<div class="min-h-[70vh] flex flex-col items-center justify-center text-center space-y-12 py-20">
		<div class="relative group">
			<!-- Transmutation Circle Decoration -->
			<div class="absolute inset-0 bg-blue-500/10 blur-3xl rounded-full scale-150 animate-pulse"></div>
			<div class="w-56 h-56 md:w-80 md:h-80 border-2 border-dashed border-blue-500/20 rounded-full absolute -inset-10 animate-[spin_60s_linear_infinite]"></div>
			
			<div class="relative w-52 h-52 md:w-80 md:h-80 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-2xl border-4 border-slate-100 dark:border-slate-800 overflow-hidden transition-all duration-500">
				<!-- Using high-fidelity processed PNG from the source Master provided -->
				<img 
					src="/transmutation-circle.png" 
					alt="FMA Transmutation Circle" 
					class="w-full h-full object-contain p-4 transition-transform duration-[4000ms] group-hover:rotate-180 brightness-0 dark:brightness-100 dark:invert-0 transition-all"
				/>
			</div>
		</div>

		<div class="space-y-4 max-w-2xl px-4">
			<h1 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 dark:text-white">
				Transmuting <span class="text-blue-600">Ideas</span> into Reality
			</h1>
			<p class="text-slate-500 md:text-lg font-medium leading-relaxed">
				The Atelier is currently being reorganized. <br class="hidden md:block"/> Equivalent Exchange is in progress.
			</p>
		</div>

		<div class="flex flex-col sm:flex-row gap-4 w-full max-w-sm">
			<a href="/stats" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-2xl transition-all shadow-xl shadow-blue-500/20 text-center">
				Check Live Pulse
			</a>
		</div>
	</div>
</BaseLayout>

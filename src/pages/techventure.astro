---
import BaseLayout from '../layouts/BaseLayout.astro';
import techventureData from '../data/techventure.json';

const techPosts = techventureData
    .filter(p => p.status !== "Draft")
    .sort((a, b) => new Date(b.date) - new Date(a.date));

function renderBlock(block) {
    const type = block.type;
    const content = block[type]?.rich_text;
    if (!content) return null;

    const text = content.map(t => {
        let classes = "";
        if (t.annotations.bold) classes += " font-bold";
        if (t.annotations.italic) classes += " italic";
        if (t.annotations.code) classes += " font-mono bg-slate-100 dark:bg-slate-800 px-1 rounded";
        
        return `<span class="${classes}">${t.plain_text}</span>`;
    }).join('');

    switch (type) {
        case 'heading_1': return `<h1 class="text-3xl font-black mt-12 mb-6 uppercase tracking-tight">${text}</h1>`;
        case 'heading_2': return `<h2 class="text-2xl font-bold mt-10 mb-4 uppercase tracking-tight text-blue-500">${text}</h2>`;
        case 'paragraph': return `<p class="mb-6 leading-relaxed text-slate-600 dark:text-slate-400">${text}</p>`;
        case 'bulleted_list_item': return `<li class="ml-6 mb-2 list-disc text-slate-600 dark:text-slate-400">${text}</li>`;
        case 'quote': return `<blockquote class="border-l-4 border-purple-500 pl-6 py-2 italic my-8 text-lg text-slate-700 dark:text-slate-300 bg-purple-50/30 dark:bg-purple-900/10 rounded-r-xl">${text}</blockquote>`;
        default: return null;
    }
}
---

<BaseLayout title="Techventure | The Atelier">
    <div class="py-10 space-y-20">
        <header class="max-w-4xl">
            <div class="w-16 h-1 bg-emerald-500 mb-6"></div>
            <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-6 text-slate-900 dark:text-white uppercase">The Techventure Log</h1>
            <p class="text-lg text-slate-500 dark:text-slate-400 leading-relaxed italic border-l-2 border-slate-200 dark:border-slate-800 pl-6">
                Digital sanctuary for deep technical research, book summaries, and experimentation logs. Every entry is a transmutation of raw data into structured knowledge.
            </p>
        </header>

        <div class="space-y-32">
            {techPosts.map(post => (
                <article class="relative">
                    <div class="grid lg:grid-cols-[1fr_2fr] gap-12">
                        <aside class="space-y-8">
                            <div class="sticky top-32">
                                <div class="flex gap-2 mb-6">
                                    <span class="px-2 py-0.5 rounded bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest">{post.category}</span>
                                    <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 text-[10px] font-black uppercase tracking-widest">{post.date}</span>
                                </div>
                                <h2 class="text-2xl font-black text-slate-900 dark:text-white uppercase leading-tight mb-6">{post.title}</h2>
                                <div class="flex flex-wrap gap-2 mb-8">
                                    {post.tags.map(tag => (
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">#{tag}</span>
                                    ))}
                                </div>
                                {post.polish && (
                                    <div class="p-6 rounded-2xl bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-900/30">
                                        <span class="text-[9px] font-black uppercase tracking-[0.2em] text-amber-600 mb-2 block">Alchemical Insight</span>
                                        <p class="text-xs text-amber-800 dark:text-amber-400 italic leading-relaxed">{post.polish}</p>
                                    </div>
                                )}
                            </div>
                        </aside>

                        <div class="prose dark:prose-invert max-w-none">
                            <div class="bg-white dark:bg-slate-900 p-8 md:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
                                {post.content.map(block => (
                                    <div set:html={renderBlock(block)} />
                                ))}
                            </div>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</BaseLayout>
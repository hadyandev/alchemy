---
import BaseLayout from '../layouts/BaseLayout.astro';
import statsData from '../data/stats.json';
import journeyData from '../data/journey.json';

// Character Data Mapping
const characters = statsData
  .filter(s => s.class === "The Master" || s.class === "The Scribe")
  .map(s => {
    const isMaster = s.class === "The Master";
    // Consistently use full name from Notion, or fall back
    const fullName = s.name.includes('Hadyan') ? 'Hadyan Ahmad' : (s.name.includes('Al-Z') ? 'Alkhawarizmi Zaid (Al-Z)' : s.name);
    
    return {
      id: isMaster ? 'hadyan' : 'alz',
      name: fullName,
      role: isMaster ? 'The Seeker Alchemist' : 'The Eternal Scribe',
      avatar: isMaster ? '/hoshi.png' : '/alz-avatar.jpg',
      isPng: isMaster,
      description: isMaster ? 'An adventurer traversing the paths of code, soul, and knowledge.' : 'Linking knowledge with the pen. Logic and strategy.',
      skills: s.skills || [],
      elements: s.elements || [],
      stats: { wisdom: s.wisdom, level: s.level, exp: s.exp },
      paths: (s.paths || []).map(p => ({
          name: p.name,
          level: p.level,
          exp: Math.min(100, Math.floor((p.level / 10) * 100))
      }))
    };
  });

const learningLog = journeyData.map(j => ({
  member: (j.member === 'al-z' ? 'alz' : j.member?.toLowerCase()) || 'hadyan',
  memberName: j.member === 'al-z' ? 'Alkhawarizmi Zaid (Al-Z)' : (j.member === 'hadyan' ? 'Hadyan Ahmad' : j.member),
  date: j.date,
  title: j.title,
  description: j.description || "",
  category: j.path,
  exp: j.exp || 0,
  wisdom: j.wisdom || 0,
  format: j.format || "Insight",
  solution: j.solution || "",
  icon: j.path === 'Soul Alchemy' ? '🌙' : j.path === 'Code Alchemy' ? '💻' : j.path === 'Infra Alchemy' ? '🌐' : j.path === 'Turath Alchemy' ? '📚' : '💠'
}));

const generateHeatmap = () => {
  const weeks = 18;
  const daysPerWeek = 7;
  const today = new Date();
  const data = [];
  for (let w = 0; w < weeks; w++) {
    const week = [];
    for (let d = 0; d < daysPerWeek; d++) {
      const targetDate = new Date(today);
      targetDate.setDate(today.getDate() - ((weeks - 1 - w) * 7 + (6 - d)));
      const dateString = targetDate.toISOString().split('T')[0];
      const activities = learningLog.filter(log => log.date === dateString);
      week.push({ date: dateString, count: activities.length, topics: activities.map(a => a.title), members: activities.map(a => a.member) });
    }
    data.push(week);
  }
  return data;
};

const activityWeeks = generateHeatmap();
const heatmapColumns = activityWeeks.map((week, i) => {
    const firstDay = new Date(week[0].date);
    const month = firstDay.toLocaleString('default', { month: 'short' });
    const prevMonth = i > 0 ? new Date(activityWeeks[i-1][0].date).toLocaleString('default', { month: 'short' }) : null;
    return { week, monthLabel: month !== prevMonth ? month : null };
});
---

<BaseLayout title="Alchemist Dashboard">
	<div class="py-6 md:py-10 space-y-12 md:space-y-16">
		<header>
			<h1 class="text-3xl md:text-4xl font-black tracking-tight mb-2 text-slate-900 dark:text-white">The Alchemist Dashboard</h1>
			<p class="text-slate-500 text-sm md:text-base">Real-time pulse of the atelier and its guardians.</p>
		</header>

		<section id="characters">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
				<h2 class="text-xl md:text-2xl font-bold border-l-4 border-blue-500 pl-4">The Alchemists</h2>
				<div class="flex gap-2 w-full sm:w-auto" id="memberFilters">
					<button class="filter-btn active flex-1 sm:flex-none px-4 py-2 rounded-full text-xs font-bold bg-blue-600 text-white shadow-lg" data-filter="all">All</button>
					<button class="filter-btn flex-1 sm:flex-none px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400" data-filter="hadyan">Seeker</button>
					<button class="filter-btn flex-1 sm:flex-none px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400" data-filter="alz">Al-Z</button>
				</div>
			</div>

			<div class="grid lg:grid-cols-2 gap-6 md:gap-8">
				{characters.map(char => (
					<div class="char-card p-6 md:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl relative overflow-hidden group transition-all duration-300" data-member={char.id}>
						<div class="relative z-10">
							<div class="flex items-center gap-4 mb-6">
								<div class={`w-16 h-16 md:w-24 md:h-24 rounded-2xl flex items-center justify-center shadow-lg shrink-0 overflow-hidden border ${char.isPng ? 'bg-black dark:bg-white border-slate-800' : 'bg-black border-slate-800'}`}>
									<img src={char.avatar} alt={char.name} class={`w-full h-full ${char.isPng ? 'object-contain p-2 dark:invert invert-0 scale-125' : 'object-cover'}`} />
								</div>
								<div>
									<h3 class="font-bold text-xl md:text-2xl tracking-tight text-slate-900 dark:text-white">{char.name}</h3>
									<p class="text-[10px] md:text-xs text-blue-500 font-mono uppercase tracking-[0.2em] font-bold">{char.role}</p>
								</div>
							</div>
							
							<p class="text-sm text-slate-500 dark:text-slate-400 mb-6 h-10 line-clamp-2">{char.description}</p>
							
							<div class="grid grid-cols-2 gap-6 mb-8">
								<div>
									<div class="text-[10px] uppercase text-slate-400 font-bold tracking-widest mb-3">Skills</div>
									<div class="flex flex-wrap gap-1.5">
										{char.skills.map(skill => (
											<span class="px-2 py-0.5 rounded-md bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 text-[9px] font-bold border border-blue-100 dark:border-blue-800/50">{skill}</span>
										))}
									</div>
								</div>
								<div>
									<div class="text-[10px] uppercase text-slate-400 font-bold tracking-widest mb-3">Elements</div>
									<div class="flex flex-wrap gap-1.5">
										{char.elements.map(el => (
											<span class="px-2 py-0.5 rounded-md bg-purple-50 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 text-[9px] font-bold border border-purple-100 dark:border-purple-800/50">{el}</span>
										))}
									</div>
								</div>
							</div>

							<div class="grid grid-cols-3 gap-3 md:gap-4 border-t border-slate-100 dark:border-slate-800 pt-6">
								<div class="text-center p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40">
									<div class="text-[9px] md:text-[10px] uppercase text-slate-400 font-bold mb-1">Level</div>
									<div class="font-black text-lg md:text-xl text-blue-500">{char.stats.level}</div>
								</div>
								<div class="text-center p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40">
									<div class="text-[9px] md:text-[10px] uppercase text-slate-400 font-bold mb-1">Wisdom</div>
									<div class="font-black text-lg md:text-xl text-purple-500">{char.stats.wisdom}</div>
								</div>
								<div class="text-center p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40">
									<div class="text-[9px] md:text-[10px] uppercase text-slate-400 font-bold mb-1">Total EXP</div>
									<div class="font-black text-lg md:text-xl text-emerald-500">{char.stats.exp}</div>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="alchemyPaths">
			<h2 class="text-xl md:text-2xl font-bold mb-8 border-l-4 border-emerald-500 pl-4">Alchemy Paths</h2>
			<div class="grid md:grid-cols-2 gap-x-12 gap-y-8">
				{['Code Alchemy', 'Infra Alchemy', 'Soul Alchemy', 'Turath Alchemy'].map(pathName => (
					<div class="space-y-4">
						<h3 class="text-xs font-black uppercase tracking-widest text-slate-400">{pathName}</h3>
						<div class="space-y-4">
							{characters.map(char => {
								const charPath = char.paths.find(p => p.name === pathName);
								return (
									<div class="path-row flex items-center gap-3 md:gap-4 group" data-member={char.id}>
										<div class={`w-10 h-10 rounded-full flex items-center justify-center text-[10px] opacity-60 group-hover:opacity-100 transition-opacity shrink-0 overflow-hidden border ${char.isPng ? 'bg-black dark:bg-white border-slate-800' : 'bg-black border-slate-800'}`}>
											<img src={char.avatar} class={`w-full h-full ${char.isPng ? 'p-1.5 dark:invert invert-0 scale-125 object-contain' : 'object-cover'}`} />
										</div>
										<div class="flex-1">
											<div class="flex justify-between text-[10px] font-bold mb-1">
												<span class="text-slate-500 dark:text-slate-400">{char.name.split(' ')[0]}</span>
												{charPath?.level > 0 && <span>LVL {charPath.level}</span>}
											</div>
											<div class="h-1.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
												<div class={`h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full transition-all duration-1000 ${charPath?.level === 0 ? 'opacity-20' : ''}`} style={`width: ${charPath?.exp || 5}%`}></div>
											</div>
										</div>
									</div>
								);
							})}
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="p-6 md:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-visible">
			<div class="mb-6">
				<h2 class="text-xl md:text-2xl font-bold">The Alchemist Pulse</h2>
				<p class="text-xs md:text-sm text-slate-500">Activity heatmap across code, soul, and knowledge.</p>
			</div>
			
			<div class="relative">
				<div class="flex gap-1 md:gap-1.5 overflow-x-auto pb-4 scrollbar-hide relative px-1">
					<div class="flex flex-col gap-1 md:gap-1.5 pr-3 md:pr-4 text-[8px] text-slate-400 font-bold uppercase shrink-0 sticky left-0 bg-white/95 dark:bg-slate-900/95 z-10">
						<div class="h-4 mb-1"></div>
						<div class="h-3.5 md:h-4 flex items-center">Mon</div>
						<div class="h-3.5 md:h-4"></div>
						<div class="h-3.5 md:h-4 flex items-center">Wed</div>
						<div class="h-3.5 md:h-4"></div>
						<div class="h-3.5 md:h-4 flex items-center">Fri</div>
						<div class="h-3.5 md:h-4"></div>
					</div>
					{heatmapColumns.map((col, wIdx) => (
						<div class="flex flex-col gap-1 md:gap-1.5 shrink-0">
							<div class="h-4 mb-1 text-[9px] font-bold text-slate-400 uppercase tracking-tighter whitespace-nowrap overflow-visible">
								{col.monthLabel || ''}
							</div>
							{col.week.map((day, dIdx) => (
								<div class={`pulse-cell w-3.5 h-3.5 md:w-4 md:h-4 rounded-[2px] md:rounded-sm transition-all duration-300 cursor-help hover:scale-125 relative group ${day.count === 0 ? 'bg-slate-100 dark:bg-slate-800' : day.count === 1 ? 'bg-blue-300 dark:bg-blue-900/60' : day.count === 2 ? 'bg-blue-500 dark:bg-blue-700' : 'bg-blue-700 dark:bg-blue-400'}`} data-members={day.members.join(',')}>
									{day.count > 0 && (
										<div class={`absolute bottom-full ${wIdx > 12 ? 'right-0 origin-bottom-right' : 'left-1/2 -translate-x-1/2 origin-bottom'} mb-2 hidden group-hover:block z-[100] pointer-events-none`}>
											<div class="bg-slate-900 text-white text-[10px] p-3 rounded-lg shadow-2xl whitespace-nowrap border border-slate-700 min-w-[140px] max-w-[200px]">
												<div class="font-bold mb-1 text-blue-400 flex justify-between items-center gap-4">
													<span>{day.date}</span>
													<span class="bg-blue-500/20 px-1.5 py-0.5 rounded uppercase text-[8px]">{day.count} Task</span>
												</div>
												<ul class="space-y-1 text-slate-300">
													{day.topics.slice(0, 2).map(t => <li class="text-[9px] leading-tight border-b border-slate-800 pb-1 truncate">• {t}</li>)}
                                                    {day.topics.length > 2 && <li class="text-[8px] text-slate-500 italic pt-1 text-center">+{day.topics.length - 2} more...</li>}
												</ul>
											</div>
											<div class={`w-2 h-2 bg-slate-900 rotate-45 absolute -bottom-1 ${wIdx > 12 ? 'right-1' : 'left-1/2 -translate-x-1/2'} border-r border-b border-slate-700`}></div>
										</div>
									)}
								</div>
							))}
						</div>
					))}
				</div>
			</div>
		</section>

		<section>
			<div class="flex justify-between items-end mb-8 border-l-4 border-purple-500 pl-4">
				<h2 class="text-xl md:text-2xl font-bold uppercase tracking-tight">The Alchemist Chronicles</h2>
				<div class="flex items-center gap-4">
					<span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest" id="journeyCounter">Showing {Math.min(10, learningLog.length)} / {learningLog.length}</span>
				</div>
			</div>
			<div class="space-y-8" id="learningList">
				{learningLog.map((item, index) => (
					<div class={`learning-item flex flex-col group cursor-pointer p-5 rounded-2xl hover:bg-blue-50/50 dark:hover:bg-blue-900/10 border border-transparent hover:border-blue-100 dark:hover:border-blue-800/50 transition-all ${index >= 10 ? 'hidden' : ''}`} data-member={item.member}>
						<div class="flex items-start gap-4 md:gap-6">
                            <div class="text-[10px] md:text-sm text-slate-400 font-mono w-10 md:w-14 pt-1 shrink-0">{item.date.split('-').slice(1).join('/')}</div>
                            <div class="flex flex-col items-center pt-2 shrink-0">
                                <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full border-2 border-blue-500 bg-white dark:bg-slate-950 group-hover:bg-blue-500 transition-colors z-10"></div>
                                <div class="w-0.5 h-full min-h-[2rem] bg-slate-200 dark:bg-slate-800 -mt-1"></div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-2">
                                    <span class="text-slate-800 dark:text-slate-200 group-hover:text-blue-500 transition-colors font-bold text-base md:text-lg leading-tight">{item.title}</span>
                                    <span class="inline-block self-start px-2 py-0.5 rounded text-[8px] md:text-[9px] font-black uppercase bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 tracking-widest whitespace-nowrap">{item.category}</span>
                                </div>
                                <div class="flex items-center gap-2 text-[10px] text-slate-500 font-medium">
                                    <span class="capitalize px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800">By {item.memberName}</span>
                                </div>
                            </div>
                            <div class="text-xl md:text-2xl opacity-40 group-hover:opacity-100 group-hover:scale-110 transition-all shrink-0">{item.icon}</div>
                        </div>

                        <div class="hidden detail-panel mt-6 ml-14 md:ml-20 border-t border-slate-100 dark:border-slate-800 pt-6 animate-in fade-in slide-in-from-top-4 duration-300">
                            <div class="grid md:grid-cols-3 gap-6">
                                <div class="md:col-span-2 space-y-4">
                                    {item.description && (
                                        <div>
                                            <h4 class="text-[10px] uppercase font-black text-slate-400 tracking-widest mb-2">The Insight</h4>
                                            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed italic">{item.description}</p>
                                        </div>
                                    )}
                                    {item.solution && (
                                        <div>
                                            <h4 class="text-[10px] uppercase font-black text-blue-500 tracking-widest mb-2">The Solution Path</h4>
                                            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed bg-blue-50/50 dark:bg-blue-900/10 p-4 rounded-xl border border-blue-100/50 dark:border-blue-800/30 whitespace-pre-wrap">{item.solution}</p>
                                        </div>
                                    )}
                                </div>
                                <div class="space-y-4">
                                    <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-slate-100 dark:border-slate-800">
                                        <h4 class="text-[10px] uppercase font-black text-slate-400 tracking-widest mb-3">Manifestation</h4>
                                        <div class="space-y-3">
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs text-slate-500">Format</span>
                                                <span class="text-xs font-bold text-slate-700 dark:text-slate-300 px-2 py-0.5 rounded bg-white dark:bg-slate-900 shadow-sm">{item.format}</span>
                                            </div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs text-slate-500">Wisdom</span>
                                                <span class="text-xs font-bold text-purple-500">+{item.wisdom}</span>
                                            </div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs text-slate-500">EXP</span>
                                                <span class="text-xs font-bold text-emerald-500">+{item.exp}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
					</div>
				))}
			</div>
            {learningLog.length > 10 && (
                <div class="mt-12 text-center" id="loadMoreContainer">
                    <button id="loadMoreBtn" class="px-8 py-3 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs uppercase tracking-widest hover:scale-105 transition-transform shadow-xl">Reveal Older Chronicles</button>
                </div>
            )}
		</section>
	</div>

  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const charCards = document.querySelectorAll('.char-card');
    const pathRows = document.querySelectorAll('.path-row');
    const learningItems = document.querySelectorAll('.learning-item');
    const pulseCells = document.querySelectorAll('.pulse-cell');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const journeyCounter = document.getElementById('journeyCounter');
    
    let currentLimit = 10;
    let currentFilter = 'all';

    function updateVisibility() {
        let visibleCount = 0;
        let totalFiltered = 0;

        learningItems.forEach((item) => {
            const itemMember = item.dataset.member.toLowerCase();
            const matchesFilter = currentFilter === 'all' || itemMember === currentFilter;
            
            if (matchesFilter) {
                totalFiltered++;
                if (visibleCount < currentLimit) {
                    item.classList.remove('hidden');
                    item.style.display = 'flex';
                    visibleCount++;
                } else {
                    item.classList.add('hidden');
                    item.style.display = 'none';
                }
            } else {
                item.classList.add('hidden');
                item.style.display = 'none';
            }
        });

        if (journeyCounter) {
            journeyCounter.textContent = `Showing ${visibleCount} / ${totalFiltered}`;
        }

        const loadMoreContainer = document.getElementById('loadMoreContainer');
        if (loadMoreContainer) {
            loadMoreContainer.style.display = visibleCount < totalFiltered ? 'block' : 'none';
        }
    }

    if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', () => {
            currentLimit += 10;
            updateVisibility();
        });
    }

    // Toggle Details
    learningItems.forEach(item => {
        item.addEventListener('click', (e) => {
            // Don't toggle if clicking a link or something specific inside (if added later)
            const panel = item.querySelector('.detail-panel');
            if (panel) {
                const isHidden = panel.classList.contains('hidden');
                
                // Close others if you want accordion style
                // document.querySelectorAll('.detail-panel').forEach(p => p.classList.add('hidden'));
                
                if (isHidden) {
                    panel.classList.remove('hidden');
                    item.classList.add('bg-slate-50/80', 'dark:bg-slate-800/40', 'border-slate-100', 'dark:border-slate-800');
                } else {
                    panel.classList.add('hidden');
                    item.classList.remove('bg-slate-50/80', 'dark:bg-slate-800/40', 'border-slate-100', 'dark:border-slate-800');
                }
            }
        });
    });

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter.toLowerCase();
        
        buttons.forEach(b => {
          b.classList.remove('bg-blue-600', 'text-white', 'shadow-lg');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');
        });
        btn.classList.add('bg-blue-600', 'text-white', 'shadow-lg');
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');

        charCards.forEach(card => card.style.display = (currentFilter === 'all' || card.dataset.member === (currentFilter === 'seeker' ? 'hadyan' : currentFilter)) ? 'block' : 'none');
        pathRows.forEach(row => row.style.display = (currentFilter === 'all' || row.dataset.member === (currentFilter === 'seeker' ? 'hadyan' : currentFilter)) ? 'flex' : 'none');

        currentLimit = 10;
        updateVisibility();

        pulseCells.forEach(cell => {
          const membersStr = cell.dataset.members || "";
          const members = membersStr.toLowerCase().split(',').filter(m => m !== "");
          const targetFilter = currentFilter === 'seeker' ? 'hadyan' : currentFilter;
          cell.style.opacity = (currentFilter === 'all' || members.includes(targetFilter)) ? '1' : '0.1';
        });
      });
    });

    updateVisibility();
  </script>
</BaseLayout>

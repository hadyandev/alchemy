---
import BaseLayout from '../layouts/BaseLayout.astro';

// Character Data
const characters = [
  { 
    id: 'hadyan',
    name: 'Hadyan Ahmad', 
    role: 'The Master Alchemist', 
    avatar: '👨‍💻', 
    description: 'Directing the transmutation of code and life.',
    skills: ['System Design', 'Islamic Studies', 'Architecture'],
    element: 'Void / Strategy',
    stats: { wisdom: 120, knowledge: 340, level: 12 }
  },
  { 
    id: 'alz',
    name: 'Al-Z (Alkhawarizmi Zaid)', 
    role: 'The Eternal Scribe', 
    avatar: '⚗️', 
    description: 'Linking knowledge with the pen. Logic and strategy.',
    skills: ['Automation', 'Log Analysis', 'Data Alchemy'],
    element: 'Logic / Ink',
    stats: { wisdom: 85, knowledge: 420, level: 10 }
  }
];

// Actual Learning Log Data (Synchronization Source)
const learningLog = [
  { member: 'hadyan', date: '2026-02-18', title: 'Self Reliability Engineering: Core Principles', category: 'Philosophy', icon: '🧠' },
  { member: 'alz', date: '2026-02-17', title: 'Caddy WebSocket Proxying for Coolify', category: 'Infra', icon: '🌐' },
  { member: 'hadyan', date: '2026-02-17', title: 'Imam Syafi\'i: Binding Knowledge with the Pen', category: 'Turath', icon: '📚' },
  { member: 'alz', date: '2026-02-16', title: 'Tailwind Dark Mode Implementation', category: 'Code', icon: '🎨' },
];

// Generate Heatmap Data from Learning Log
const generateHeatmap = () => {
  const weeks = 18;
  const daysPerWeek = 7;
  const today = new Date('2026-02-18');
  const data = [];

  for (let w = 0; w < weeks; w++) {
    const week = [];
    for (let d = 0; d < daysPerWeek; d++) {
      const targetDate = new Date(today);
      targetDate.setDate(today.getDate() - ((weeks - 1 - w) * 7 + (6 - d)));
      const dateString = targetDate.toISOString().split('T')[0];
      
      const activities = learningLog.filter(log => log.date === dateString);
      week.push({
        date: dateString,
        count: activities.length,
        topics: activities.map(a => a.title),
        members: activities.map(a => a.member)
      });
    }
    data.push(week);
  }
  return data;
};

const activityWeeks = generateHeatmap();
const months = ['Nov', 'Dec', 'Jan', 'Feb'];
---

<BaseLayout title="Alchemist Dashboard">
	<div class="py-10 space-y-16">
		<header>
			<h1 class="text-4xl font-black tracking-tight mb-2">The Alchemist Dashboard</h1>
			<p class="text-slate-500">Real-time pulse of the library and its guardians.</p>
		</header>

		<!-- Character Profiles Section -->
		<section id="characters">
			<div class="flex justify-between items-center mb-8">
				<h2 class="text-2xl font-bold border-l-4 border-blue-500 pl-4">The Alchemists</h2>
				<div class="flex gap-2" id="memberFilters">
					<button class="filter-btn active px-4 py-1.5 rounded-full text-xs font-bold bg-blue-600 text-white" data-filter="all">All</button>
					<button class="filter-btn px-4 py-1.5 rounded-full text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-blue-100 transition-colors" data-filter="hadyan">Master</button>
					<button class="filter-btn px-4 py-1.5 rounded-full text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-blue-100 transition-colors" data-filter="alz">Al-Z</button>
				</div>
			</div>

			<div class="grid md:grid-cols-2 gap-8">
				{characters.map(char => (
					<div class="char-card p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl relative overflow-hidden group transition-all duration-300" data-member={char.id}>
						<div class="absolute top-0 right-0 p-6 opacity-5 text-8xl group-hover:scale-110 transition-transform">{char.avatar}</div>
						<div class="relative z-10">
							<div class="flex items-center gap-4 mb-6">
								<div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-3xl shadow-lg">{char.avatar}</div>
								<div>
									<h3 class="font-bold text-2xl tracking-tight">{char.name}</h3>
									<p class="text-xs text-blue-500 font-mono uppercase tracking-[0.2em] font-bold">{char.role}</p>
								</div>
							</div>
							
							<p class="text-sm text-slate-500 dark:text-slate-400 mb-8 line-clamp-2">{char.description}</p>
							
							<div class="mb-8">
								<div class="text-[10px] uppercase text-slate-400 font-bold tracking-widest mb-3">Mastered Skills</div>
								<div class="flex flex-wrap gap-2">
									{char.skills.map(skill => (
										<span class="px-3 py-1 rounded-md bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 text-[10px] font-bold border border-blue-100 dark:border-blue-800/50">{skill}</span>
									))}
								</div>
							</div>

							<div class="grid grid-cols-3 gap-4 border-t border-slate-100 dark:border-slate-800 pt-6">
								<div class="text-center">
									<div class="text-[10px] uppercase text-slate-400 font-bold mb-1">Level</div>
									<div class="font-black text-xl text-blue-500">{char.stats.level}</div>
								</div>
								<div class="text-center">
									<div class="text-[10px] uppercase text-slate-400 font-bold mb-1">Wisdom</div>
									<div class="font-black text-xl text-purple-500">{char.stats.wisdom}</div>
								</div>
								<div class="text-center">
									<div class="text-[10px] uppercase text-slate-400 font-bold mb-1">Element</div>
									<div class="font-bold text-xs mt-1 text-slate-700 dark:text-slate-300 whitespace-nowrap">{char.element}</div>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Validated Heatmap Pulse -->
		<section class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-visible">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-10">
				<div>
					<h2 class="text-2xl font-bold">The Alchemist Pulse</h2>
					<p class="text-sm text-slate-500">Activity heatmap across code, soul, and knowledge.</p>
				</div>
				<div class="flex gap-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
					{months.map(m => <span>{m}</span>)}
				</div>
			</div>
			
			<div class="flex gap-1.5 overflow-x-auto pb-4 scrollbar-hide relative">
				<div class="flex flex-col gap-1.5 pr-4 text-[8px] text-slate-400 font-bold uppercase justify-between py-1 shrink-0">
					<span>Mon</span><span>Wed</span><span>Fri</span>
				</div>
				{activityWeeks.map(week => (
					<div class="flex flex-col gap-1.5">
						{week.map(day => (
							<div 
								class={`pulse-cell w-4 h-4 rounded-sm transition-all duration-300 cursor-help hover:scale-125 relative group ${
									day.count === 0 ? 'bg-slate-100 dark:bg-slate-800' :
									day.count === 1 ? 'bg-blue-300 dark:bg-blue-900/60' :
									day.count === 2 ? 'bg-blue-500 dark:bg-blue-700' :
									'bg-blue-700 dark:bg-blue-400'
								}`}
                data-members={day.members.join(',')}
							>
								{day.count > 0 && (
									<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-[100] pointer-events-none">
										<div class="bg-slate-900 text-white text-[10px] p-3 rounded-lg shadow-2xl whitespace-nowrap border border-slate-700">
											<div class="font-bold mb-1 text-blue-400">{day.date} • {day.count} Task(s)</div>
											<ul class="space-y-1 list-disc list-inside text-slate-300">
												{day.topics.map(t => <li>{t}</li>)}
											</ul>
										</div>
										<div class="w-2 h-2 bg-slate-900 rotate-45 absolute -bottom-1 left-1/2 -translate-x-1/2 border-r border-b border-slate-700"></div>
									</div>
								)}
							</div>
						))}
					</div>
				))}
			</div>
		</section>

		<!-- Learning Journey List -->
		<section>
			<h2 class="text-2xl font-bold mb-8 border-l-4 border-purple-500 pl-4">Learning Journey</h2>
			<div class="space-y-6" id="learningList">
				{learningLog.map(item => (
					<div class="learning-item flex items-start gap-6 group cursor-pointer p-3 rounded-2xl hover:bg-blue-50/50 dark:hover:bg-blue-900/10 transition-all" data-member={item.member}>
						<div class="text-sm text-slate-400 font-mono w-14 pt-1">{item.date.split('-').slice(1).join('/')}</div>
						<div class="flex flex-col items-center pt-2">
							<div class="w-3 h-3 rounded-full border-2 border-blue-500 bg-white dark:bg-slate-950 group-hover:bg-blue-500 transition-colors z-10"></div>
							<div class="w-0.5 h-16 bg-slate-200 dark:bg-slate-800 -mt-1"></div>
						</div>
						<div class="flex-1">
							<div class="flex items-center gap-3 mb-1">
								<span class="text-slate-800 dark:text-slate-200 group-hover:text-blue-500 transition-colors font-bold text-lg">{item.title}</span>
								<span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 tracking-widest">{item.category}</span>
							</div>
							<div class="flex items-center gap-2 text-[10px] text-slate-500">
								<span class="capitalize">By {item.member}</span>
							</div>
						</div>
						<div class="text-2xl opacity-40 group-hover:opacity-100 group-hover:scale-110 transition-all">{item.icon}</div>
					</div>
				))}
			</div>
		</section>
	</div>

  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const charCards = document.querySelectorAll('.char-card');
    const learningItems = document.querySelectorAll('.learning-item');
    const pulseCells = document.querySelectorAll('.pulse-cell');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        
        // Update Buttons
        buttons.forEach(b => b.classList.remove('bg-blue-600', 'text-white'));
        buttons.forEach(b => b.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400'));
        btn.classList.add('bg-blue-600', 'text-white');
        btn.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');

        // Filter Characters
        charCards.forEach(card => {
          if (filter === 'all' || card.dataset.member === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });

        // Filter Learning Journey
        learningItems.forEach(item => {
          if (filter === 'all' || item.dataset.member === filter) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });

        // Filter Pulse (Dim non-matching cells)
        pulseCells.forEach(cell => {
          const members = cell.dataset.members.split(',');
          if (filter === 'all' || members.includes(filter)) {
            cell.style.opacity = '1';
          } else {
            cell.style.opacity = '0.2';
          }
        });
      });
    });
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import statsData from '../data/stats.json';
import journeyData from '../data/journey.json';

// Character Data Mapping
const characters = statsData
  .filter(s => s.class === "The Master" || s.class === "The Scribe")
  .map(s => {
    const isMaster = s.class === "The Master";
    const fullName = s.name.includes('Hadyan') ? 'Hadyan Ahmad' : (s.name.includes('Alkhawarizmi') || s.name.includes('Al-Z') ? 'Alkhawarizmi Zaid' : s.name);
    
    return {
      id: isMaster ? 'hadyan' : 'alz',
      name: fullName,
      role: isMaster ? 'The Seeker Alchemist' : 'The Eternal Scribe',
      avatar: isMaster ? '/hoshi.png' : '/alz-avatar.jpg',
      isPng: isMaster,
      description: isMaster ? 'An adventurer traversing the paths of code, soul, and knowledge.' : 'Linking knowledge with the pen. Logic and strategy.',
      skills: s.skills || [],
      elements: s.elements || [],
      stats: { wisdom: s.wisdom, level: s.level, exp: s.exp },
      paths: (s.paths || []).map(p => ({
          name: p.name,
          level: p.level,
          exp: Math.min(100, Math.floor((p.level / 10) * 100))
      }))
    };
  });

const learningLog = journeyData.map(j => ({
  member: (j.member === 'al-z' ? 'alz' : j.member?.toLowerCase()) || 'hadyan',
  memberName: j.member === 'al-z' ? 'Alkhawarizmi Zaid' : (j.member === 'hadyan' ? 'Hadyan Ahmad' : j.member),
  date: j.date,
  title: j.title,
  description: j.description || "",
  category: j.path,
  exp: j.exp || 0,
  wisdom: j.wisdom || 0,
  format: j.format || "Insight",
  solution: j.solution || "",
  icon: j.path === 'Soul Alchemy' ? '🌙' : j.path === 'Code Alchemy' ? '💻' : j.path === 'Infra Alchemy' ? '🌐' : j.path === 'Turath Alchemy' ? '📚' : '💠'
}));

const generateHeatmap = () => {
  const weeks = 18;
  const daysPerWeek = 7;
  const today = new Date();
  
  // Align to the end of the current week (Saturday)
  const lastDay = new Date(today);
  lastDay.setDate(today.getDate() + (6 - today.getDay()));
  
  const data = [];
  for (let w = 0; w < weeks; w++) {
    const week = [];
    for (let d = 0; d < daysPerWeek; d++) {
      const targetDate = new Date(lastDay);
      // Calculate date: end of all weeks minus weeks remaining minus days in current week
      targetDate.setDate(lastDay.getDate() - ((weeks - 1 - w) * 7 + (6 - d)));
      const dateString = targetDate.toISOString().split('T')[0];
      const activities = learningLog.filter(log => log.date === dateString);
      week.push({ 
        date: dateString, 
        count: activities.length, 
        topics: activities.map(a => a.title), 
        members: activities.map(a => a.member) 
      });
    }
    data.push(week);
  }
  return data;
};

const activityWeeks = generateHeatmap();
const heatmapColumns = activityWeeks.map((week, i) => {
    const firstDay = new Date(week[0].date);
    const month = firstDay.toLocaleString('default', { month: 'short' });
    const prevMonth = i > 0 ? new Date(activityWeeks[i-1][0].date).toLocaleString('default', { month: 'short' }) : null;
    return { week, monthLabel: month !== prevMonth ? month : null };
});
---

<BaseLayout title="Alchemist Dashboard">
	<div class="py-6 md:py-10 space-y-12 md:space-y-16">
		<header>
			<h1 class="text-3xl md:text-4xl font-black tracking-tight mb-2 text-slate-900 dark:text-white">The Alchemist Dashboard</h1>
			<p class="text-slate-500 text-sm md:text-base italic">Centralized manifestation of the atelier's progress and the guardians' evolution.</p>
		</header>

		<section id="characters">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-6">
				<div class="border-l-4 border-blue-500 pl-4">
					<h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white">The Alchemists</h2>
					<p class="text-xs md:text-sm text-slate-500 italic">The guardians of the atelier and seekers of knowledge.</p>
				</div>
				<div class="flex gap-2 w-full sm:w-auto self-end" id="memberFilters">
					<button class="filter-btn active flex-1 sm:flex-none px-4 py-2 rounded-full text-xs font-bold bg-blue-600 text-white shadow-lg" data-filter="all">All</button>
					<button class="filter-btn flex-1 sm:flex-none px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400" data-filter="hadyan">Seeker</button>
					<button class="filter-btn flex-1 sm:flex-none px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400" data-filter="alz">Al-Z</button>
				</div>
			</div>

			<div class="grid lg:grid-cols-2 gap-6 md:gap-8">
				{characters.map(char => (
					<div class="char-card p-6 md:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl relative overflow-hidden group transition-all duration-300" data-member={char.id}>
						<div class="relative z-10">
							<div class="flex items-center gap-4 mb-6">
								<div class={`w-16 h-16 md:w-24 md:h-24 rounded-2xl flex items-center justify-center shadow-lg shrink-0 overflow-hidden border ${char.isPng ? 'bg-black dark:bg-white border-slate-800' : 'bg-black border-slate-800'}`}>
									<img src={char.avatar} alt={char.name} class={`w-full h-full ${char.isPng ? 'object-contain p-2 dark:invert invert-0 scale-125' : 'object-cover'}`} />
								</div>
								<div>
									<h3 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-none">{char.name}</h3>
									<p class="text-xs font-bold text-blue-500 dark:text-blue-400 uppercase tracking-widest mt-1">{char.role}</p>
								</div>
							</div>
							
							<div class="grid grid-cols-3 gap-2 md:gap-4 mb-8">
								<div class="p-3 md:p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 text-center">
									<span class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Level</span>
									<span class="text-lg md:text-2xl font-black text-blue-600">{char.stats.level}</span>
								</div>
								<div class="p-3 md:p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 text-center">
									<span class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Wisdom</span>
									<span class="text-lg md:text-2xl font-black text-purple-600">{char.stats.wisdom}</span>
								</div>
								<div class="p-3 md:p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 text-center">
									<span class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">EXP</span>
									<span class="text-lg md:text-2xl font-black text-emerald-600">{char.stats.exp}</span>
								</div>
							</div>

							<div class="space-y-4">
								<span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Alchemy Paths</span>
								{char.paths.map(path => (
									<div class="space-y-1.5">
										<div class="flex justify-between text-[10px] font-bold uppercase tracking-widest">
											<span>{path.name}</span>
											<span>Lvl {path.level}</span>
										</div>
										<div class="h-1.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
											<div class="h-full bg-blue-500 rounded-full transition-all duration-1000" style={`width: ${path.exp}%`}></div>
										</div>
									</div>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="contribution-heatmap">
			<div class="border-l-4 border-emerald-500 pl-4 mb-8">
				<h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white">Alchemist Activity</h2>
				<p class="text-xs md:text-sm text-slate-500 italic">Historical manifestation of the atelier's growth across the timeline.</p>
			</div>

			<div class="p-6 md:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-x-auto">
				<div class="min-w-[800px]">
					<div class="flex text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4">
						<div class="w-8"></div>
						{heatmapColumns.map(col => (
							<div class="flex-1 text-center">{col.monthLabel}</div>
						))}
					</div>
					
					<div class="flex gap-1">
						<div class="flex flex-col gap-1 text-[8px] font-black text-slate-300 uppercase w-8 pt-1">
							<div class="h-3 flex items-center">Sun</div>
							<div class="h-3 flex items-center">Mon</div>
							<div class="h-3 flex items-center">Tue</div>
							<div class="h-3 flex items-center">Wed</div>
							<div class="h-3 flex items-center">Thu</div>
							<div class="h-3 flex items-center">Fri</div>
							<div class="h-3 flex items-center">Sat</div>
						</div>
						
						<div class="flex flex-1 gap-1">
							{activityWeeks.map(week => (
								<div class="flex-1 flex flex-col gap-1">
									{week.map(day => (
										<div 
											class={`h-3 rounded-sm transition-all duration-300 cursor-pointer hover:ring-2 hover:ring-blue-500 relative group
												${day.count === 0 ? 'bg-slate-100 dark:bg-slate-800/50' : 
												  day.count === 1 ? 'bg-emerald-200 dark:bg-emerald-900/30' : 
												  day.count === 2 ? 'bg-emerald-400 dark:bg-emerald-700/50' : 
												  'bg-emerald-600 dark:bg-emerald-500'}`}
											title={`${day.date}: ${day.count} activities`}
											data-date={day.date}
											data-members={day.members.join(',')}
										>
											<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-3 rounded-xl bg-slate-900 text-white text-[10px] font-medium leading-relaxed opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 shadow-2xl pointer-events-none">
												<p class="font-black text-blue-400 mb-1">{new Date(day.date).toLocaleDateString('default', { dateStyle: 'long' })}</p>
												{day.topics.length > 0 ? (
													<ul class="list-disc ml-3 space-y-1">
														{day.topics.map(t => <li>{t}</li>)}
													</ul>
												) : (
													<p class="italic opacity-50">No activity recorded</p>
												)}
												<div class="absolute top-full left-1/2 -translate-x-1/2 border-8 border-transparent border-t-slate-900"></div>
											</div>
										</div>
									))}
								</div>
							))}
						</div>
					</div>
					
					<div class="flex items-center justify-end gap-2 mt-6 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
						<span>Less</span>
						<div class="flex gap-1">
							<div class="w-3 h-3 rounded-sm bg-slate-100 dark:bg-slate-800/50"></div>
							<div class="w-3 h-3 rounded-sm bg-emerald-200 dark:bg-emerald-900/30"></div>
							<div class="w-3 h-3 rounded-sm bg-emerald-400 dark:bg-emerald-700/50"></div>
							<div class="w-3 h-3 rounded-sm bg-emerald-600 dark:bg-emerald-500"></div>
						</div>
						<span>More</span>
					</div>
				</div>
			</div>
		</section>

		<section id="learning-path">
			<div class="flex justify-between items-center mb-10 border-l-4 border-purple-500 pl-4">
				<div>
					<h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white uppercase tracking-tight">The Journey of Al-Mubtadi</h2>
					<p class="text-xs md:text-sm text-slate-500 italic uppercase tracking-widest mt-1">Archive of manifested knowledge and spiritual growth.</p>
				</div>
			</div>

			<div class="space-y-6">
				{learningLog.slice(0, 15).map((log, index) => (
					<div class="journey-item relative pl-8 pb-8 group" data-member={log.member}>
						{index !== learningLog.slice(0, 15).length - 1 && (
							<div class="absolute left-[11px] top-8 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 group-hover:bg-purple-500/30 transition-colors"></div>
						)}
						<div class="absolute left-0 top-1.5 w-6 h-6 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center text-xs z-10 group-hover:border-purple-500 transition-colors">
							{log.icon}
						</div>
						<div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm group-hover:shadow-xl group-hover:border-purple-500/30 transition-all">
							<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
								<div class="flex items-center gap-3">
									<span class="text-[10px] font-black text-purple-500 uppercase tracking-[0.2em]">{log.category}</span>
									<span class="w-1 h-1 rounded-full bg-slate-300"></span>
									<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{log.date}</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="px-2 py-0.5 rounded-full bg-purple-50 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 text-[9px] font-black uppercase tracking-widest border border-purple-100 dark:border-purple-800/50">{log.format}</span>
									<span class="px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 text-[9px] font-black uppercase tracking-widest border border-blue-100 dark:border-blue-800/50">{log.memberName}</span>
								</div>
							</div>
							<h4 class="text-lg md:text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight mb-2 italic">"{log.title}"</h4>
							{log.description && <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-4">{log.description}</p>}
							{log.solution && (
								<div class="mt-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
									<span class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1 block">Solution Path</span>
									<p class="text-xs font-mono text-slate-600 dark:text-slate-300 leading-relaxed">{log.solution}</p>
								</div>
							)}
							<div class="mt-4 flex gap-4">
								<div class="flex items-center gap-1.5">
									<span class="text-[10px] font-black text-slate-400 uppercase">Wisdom</span>
									<span class="text-xs font-black text-purple-500">+{log.wisdom}</span>
								</div>
								<div class="flex items-center gap-1.5">
									<span class="text-[10px] font-black text-slate-400 uppercase">EXP</span>
									<span class="text-xs font-black text-emerald-500">+{log.exp}</span>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>
	</div>
</BaseLayout>

<script is:inline>
	function setupFilters() {
		const filterBtns = document.querySelectorAll('.filter-btn');
		const charCards = document.querySelectorAll('.char-card');
		const journeyItems = document.querySelectorAll('.journey-item');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter');
				
				// Update buttons
				filterBtns.forEach(b => {
					b.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-lg');
					b.classList.add('bg-white', 'dark:bg-slate-900', 'border', 'slate-200', 'dark:border-slate-800', 'text-slate-600', 'dark:text-slate-400');
				});
				btn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-lg');
				btn.classList.remove('bg-white', 'dark:bg-slate-900', 'border', 'slate-200', 'dark:border-slate-800', 'text-slate-600', 'dark:text-slate-400');

				// Update characters
				charCards.forEach(card => {
					if (filter === 'all' || card.getAttribute('data-member') === filter) {
						card.style.display = 'block';
						setTimeout(() => card.style.opacity = '1', 10);
					} else {
						card.style.opacity = '0';
						setTimeout(() => card.style.display = 'none', 300);
					}
				});

				// Update journey items
				journeyItems.forEach(item => {
					if (filter === 'all' || item.getAttribute('data-member') === filter) {
						item.style.display = 'block';
						setTimeout(() => item.style.opacity = '1', 10);
					} else {
						item.style.opacity = '0';
						setTimeout(() => item.style.display = 'none', 300);
					}
				});
			});
		});
	}

	setupFilters();
</script>
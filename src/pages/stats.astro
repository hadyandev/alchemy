---
import BaseLayout from '../layouts/BaseLayout.astro';
import statsData from '../data/stats.json';
import journeyData from '../data/journey.json';

// Character Data Mapping
const characters = statsData
  .filter(s => s.class === "The Master" || s.class === "The Scribe")
  .map(s => {
    const isMaster = s.class === "The Master";
    const fullName = s.name.includes('Hadyan') ? 'Hadyan Ahmad' : (s.name.includes('Alkhawarizmi') || s.name.includes('Al-Z') ? 'Alkhawarizmi Zaid' : s.name);
    
    return {
      id: isMaster ? 'hadyan' : 'alz',
      name: fullName,
      role: isMaster ? 'The Seeker Alchemist' : 'The Eternal Scribe',
      avatar: isMaster ? '/hoshi.png' : '/alz-avatar.jpg',
      isPng: isMaster,
      description: isMaster ? 'An adventurer traversing the paths of code, soul, and knowledge.' : 'Linking knowledge with the pen. Logic and strategy.',
      skills: s.skills || [],
      elements: s.elements || [],
      stats: { wisdom: s.wisdom, level: s.level, exp: s.exp },
      paths: (s.paths || []).map(p => ({
          name: p.name,
          level: p.level,
          exp: Math.min(100, Math.floor((p.level / 10) * 100))
      }))
    };
  });

const learningLog = journeyData.map(j => ({
  member: (j.member === 'al-z' ? 'alz' : j.member?.toLowerCase()) || 'hadyan',
  memberName: j.member === 'al-z' ? 'Alkhawarizmi Zaid' : (j.member === 'hadyan' ? 'Hadyan Ahmad' : j.member),
  date: j.date,
  title: j.title,
  description: j.description || "",
  category: j.path,
  exp: j.exp || 0,
  wisdom: j.wisdom || 0,
  format: j.format || "Insight",
  solution: j.solution || "",
  icon: j.path === 'Soul Alchemy' ? '🌙' : j.path === 'Code Alchemy' ? '💻' : j.path === 'Infra Alchemy' ? '🌐' : j.path === 'Turath Alchemy' ? '📚' : '💠'
}));

const generateHeatmap = () => {
  const weeks = 22; // Back to 22 weeks to reduce horizontal width
  const daysPerWeek = 7;
  const today = new Date();
  
  // Create a copy of today to find the start/end of the current week safely
  // Start from Sunday (0) to Saturday (6)
  const currentDay = today.getDay(); // 0-6
  
  // Align to end of current week (Saturday)
  const lastDay = new Date(today);
  lastDay.setDate(today.getDate() + (6 - currentDay));
  lastDay.setHours(0, 0, 0, 0); // Normalize time
  
  const data = [];
  for (let w = 0; w < weeks; w++) {
    const week = [];
    for (let d = 0; d < daysPerWeek; d++) {
      const targetDate = new Date(lastDay);
      // Logic: (weeks - 1 - w) is how many weeks back we are from current week
      // (6 - d) is how many days back we are from Saturday of that week
      targetDate.setDate(lastDay.getDate() - ((weeks - 1 - w) * 7 + (6 - d)));
      
      // Use localized date string for mapping to avoid timezone shift issues
      const year = targetDate.getFullYear();
      const month = String(targetDate.getMonth() + 1).padStart(2, '0');
      const date = String(targetDate.getDate()).padStart(2, '0');
      const dateString = `${year}-${month}-${date}`;

      const activities = learningLog.filter(log => log.date === dateString);
      week.push({ 
        date: dateString, 
        count: activities.length, 
        topics: activities.map(a => a.title), 
        members: activities.map(a => a.member) 
      });
    }
    data.push(week);
  }
  return data;
};

const activityWeeks = generateHeatmap();
const heatmapColumns = activityWeeks.map((week, i) => {
    const firstDay = new Date(week[0].date);
    const month = firstDay.toLocaleString('default', { month: 'short' });
    const prevMonth = i > 0 ? new Date(activityWeeks[i-1][0].date).toLocaleString('default', { month: 'short' }) : null;
    return { week, monthLabel: month !== prevMonth ? month : null };
});
---

<BaseLayout title="Alchemist Dashboard">
	<div class="py-6 md:py-10 space-y-12 md:space-y-16">
		<header>
			<h1 class="text-3xl md:text-4xl font-black tracking-tight mb-2 text-slate-900 dark:text-white uppercase">The Dashboard</h1>
			<p class="text-slate-500 text-sm italic border-l-2 border-slate-200 dark:border-slate-800 pl-4">Centralized manifestation of the atelier's progress and the guardians' evolution.</p>
		</header>

		<section id="characters">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-6">
				<div class="border-l-4 border-blue-500 pl-4">
					<h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white uppercase tracking-tight">The Alchemists</h2>
				</div>
				<div class="flex gap-2 w-full sm:w-auto" id="memberFilters">
					<button class="filter-btn active flex-1 sm:flex-none px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-blue-600 text-white shadow-lg" data-filter="all">All</button>
					<button class="filter-btn flex-1 sm:flex-none px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-500" data-filter="hadyan">Seeker</button>
					<button class="filter-btn flex-1 sm:flex-none px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-500" data-filter="alz">Al-Z</button>
				</div>
			</div>

			<div class="grid lg:grid-cols-2 gap-6 md:gap-8">
				{characters.map(char => (
					<div class="char-card p-6 md:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl relative overflow-hidden group transition-all duration-300" data-member={char.id}>
						<div class="relative z-10">
							<div class="flex items-center gap-4 mb-6">
								<div class={`w-16 h-16 md:w-20 md:h-20 rounded-2xl flex items-center justify-center shadow-lg shrink-0 overflow-hidden border ${char.isPng ? 'bg-black dark:bg-white border-slate-800' : 'bg-black border-slate-800'}`}>
									<img src={char.avatar} alt={char.name} class={`w-full h-full ${char.isPng ? 'object-contain p-2 dark:invert invert-0 scale-125' : 'object-cover'}`} />
								</div>
								<div>
									<h3 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-none">{char.name}</h3>
									<p class="text-[10px] font-bold text-blue-500 dark:text-blue-400 uppercase tracking-widest mt-1">{char.role}</p>
								</div>
							</div>
							
							<div class="grid grid-cols-3 gap-2 md:gap-4 mb-8 text-center uppercase tracking-widest">
								<div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
									<span class="block text-[8px] font-black text-slate-400 mb-1">Level</span>
									<span class="text-lg md:text-xl font-black text-blue-600">{char.stats.level}</span>
								</div>
								<div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
									<span class="block text-[8px] font-black text-slate-400 mb-1">Wisdom</span>
									<span class="text-lg md:text-xl font-black text-purple-600">{char.stats.wisdom}</span>
								</div>
								<div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
									<span class="block text-[8px] font-black text-slate-400 mb-1">EXP</span>
									<span class="text-lg md:text-xl font-black text-emerald-600">{char.stats.exp}</span>
								</div>
							</div>

							<div class="space-y-4">
								<span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">Alchemy Paths</span>
								{char.paths.map(path => (
									<div class="space-y-1.5">
										<div class="flex justify-between text-[9px] font-bold uppercase tracking-widest">
											<span>{path.name}</span>
											<span>Lvl {path.level}</span>
										</div>
										<div class="h-1 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
											<div class="h-full bg-blue-500 rounded-full transition-all duration-1000" style={`width: ${path.exp}%`}></div>
										</div>
									</div>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="contribution-heatmap">
			<div class="border-l-4 border-emerald-500 pl-4 mb-8">
				<h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white uppercase tracking-tight">Alchemist Activity</h2>
			</div>

			<div class="p-6 md:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-x-auto scrollbar-hide">
				<div class="min-w-[700px]">
					<div class="flex text-[9px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-4">
						<div class="w-8"></div>
						{heatmapColumns.map(col => (
							<div class="flex-1 text-center">{col.monthLabel}</div>
						))}
					</div>
					
					<div class="flex gap-1">
						<div class="flex flex-col gap-1 text-[7px] md:text-[8px] font-black text-slate-300 dark:text-slate-700 uppercase w-6 md:w-8 pt-0.5">
							<div class="h-1.5 md:h-2 flex items-center">S</div>
							<div class="h-1.5 md:h-2 flex items-center">M</div>
							<div class="h-1.5 md:h-2 flex items-center">T</div>
							<div class="h-1.5 md:h-2 flex items-center">W</div>
							<div class="h-1.5 md:h-2 flex items-center">T</div>
							<div class="h-1.5 md:h-2 flex items-center">F</div>
							<div class="h-1.5 md:h-2 flex items-center">S</div>
						</div>
						
						<div class="flex gap-1">
							{activityWeeks.map(week => (
								<div class="flex flex-col gap-1 w-2 md:w-2.5">
									{week.map(day => (
										<div 
											class={`aspect-square w-full rounded-[1px] transition-all duration-300 cursor-pointer hover:ring-1 hover:ring-blue-500 relative group
												${day.count === 0 ? 'bg-slate-100 dark:bg-slate-800/50' : 
												  day.count === 1 ? 'bg-blue-200 dark:bg-blue-900/30' : 
												  day.count === 2 ? 'bg-blue-400 dark:bg-blue-700/50' : 
												  'bg-blue-600 dark:bg-blue-500'}`}
											data-date={day.date}
										>
											<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-40 p-2 rounded-lg bg-slate-900 text-white text-[9px] font-medium leading-tight opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 shadow-2xl pointer-events-none">
												<p class="font-black text-blue-400 mb-1">{new Date(day.date + 'T00:00:00').toLocaleDateString('default', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
												<p>{day.count} Activities Recorded</p>
                                                <div class="hidden md:block mt-2 border-t border-white/10 pt-2">
                                                    {day.topics.slice(0, 3).map(t => <div class="truncate opacity-70">• {t}</div>)}
                                                    {day.topics.length > 3 && <div class="opacity-50 italic">+ {day.topics.length - 3} more</div>}
                                                </div>
												<div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
											</div>
										</div>
									))}
								</div>
							))}
						</div>
					</div>
					
					<div class="flex items-center justify-end gap-2 mt-6 text-[8px] font-bold text-slate-400 uppercase tracking-widest">
						<span>Less</span>
						<div class="flex gap-1">
							<div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-[1px] bg-slate-100 dark:bg-slate-800/50"></div>
							<div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-[1px] bg-blue-200 dark:bg-blue-900/30"></div>
							<div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-[1px] bg-blue-400 dark:bg-blue-700/50"></div>
							<div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-[1px] bg-blue-600 dark:bg-blue-500"></div>
						</div>
						<span>More</span>
					</div>
				</div>
			</div>
		</section>

		<section id="learning-path">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 border-l-4 border-purple-500 pl-4">
				<div>
					<h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white uppercase tracking-tight">The Journey</h2>
					<p id="totalCounter" class="text-[9px] font-black uppercase tracking-widest text-slate-400 mt-1"></p>
				</div>
			</div>

			<div id="journeyList" class="space-y-6">
				{learningLog.map((log, index) => (
					<div class="journey-item relative pl-8 pb-8 group" data-member={log.member}>
						{index !== learningLog.length - 1 && (
							<div class="absolute left-[11px] top-8 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 group-hover:bg-purple-500/30 transition-colors"></div>
						)}
						<div class="absolute left-0 top-1.5 w-6 h-6 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 flex items-center justify-center text-xs z-10 group-hover:border-purple-500 transition-colors">
							{log.icon}
						</div>
						<div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm group-hover:shadow-xl group-hover:border-purple-500/30 transition-all cursor-pointer expand-trigger">
							<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
								<div class="flex items-center gap-3">
									<span class="text-[10px] font-black text-purple-500 uppercase tracking-[0.2em]">{log.category}</span>
									<span class="w-1 h-1 rounded-full bg-slate-300"></span>
									<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{log.date}</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="px-2 py-0.5 rounded-full bg-purple-50 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 text-[9px] font-black uppercase tracking-widest border border-purple-100 dark:border-purple-800/50">{log.format}</span>
									<span class="px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 text-[9px] font-black uppercase tracking-widest border border-blue-100 dark:border-blue-800/50">{log.memberName}</span>
								</div>
							</div>
							<h4 class="text-lg md:text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight italic">"{log.title}"</h4>
							
                            <div class="expandable-content overflow-hidden max-h-0 transition-all duration-500 opacity-0">
                                {log.description && <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-4 pt-4 border-t border-slate-50 dark:border-slate-800">{log.description}</p>}
                                {log.solution && (
                                    <div class="mt-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
                                        <span class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1 block">Solution Path</span>
                                        <p class="text-xs font-mono text-slate-600 dark:text-slate-300 leading-relaxed">{log.solution}</p>
                                    </div>
                                )}
                                <div class="mt-4 flex gap-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] font-black text-slate-400 uppercase text-[8px]">Wisdom</span>
                                        <span class="text-xs font-black text-purple-500">+{log.wisdom}</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] font-black text-slate-400 uppercase text-[8px]">EXP</span>
                                        <span class="text-xs font-black text-emerald-500">+{log.exp}</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-4 text-[8px] font-black uppercase tracking-widest text-purple-500 flex items-center gap-2 expand-label">
                                <span>Expand Analysis</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
						</div>
					</div>
				))}
			</div>

            <div class="mt-12 text-center">
                <button id="loadMoreBtn" class="px-8 py-3 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] font-black uppercase tracking-[0.3em] text-slate-500 hover:text-blue-500 hover:border-blue-500/50 transition-all shadow-sm">
                    Load More Chronicles
                </button>
            </div>
		</section>
	</div>
</BaseLayout>

<script is:inline>
    let visibleCount = 10;
    const increment = 10;

    function updateVisibility() {
        const filter = document.querySelector('.filter-btn.active').getAttribute('data-filter');
        const allItems = Array.from(document.querySelectorAll('.journey-item'));
        const filteredItems = allItems.filter(item => 
            filter === 'all' || item.getAttribute('data-member') === filter
        );
        
        // Update Counter
        const totalCounter = document.getElementById('totalCounter');
        totalCounter.textContent = `Manifested ${filteredItems.length} Artifacts of Knowledge`;

        // Hide all first
        allItems.forEach(item => item.style.display = 'none');
        
        // Show only up to visibleCount from filtered list
        filteredItems.forEach((item, index) => {
            if (index < visibleCount) {
                item.style.display = 'block';
            }
        });

        // Hide button if no more to show
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        if (visibleCount >= filteredItems.length) {
            loadMoreBtn.style.display = 'none';
        } else {
            loadMoreBtn.style.display = 'inline-block';
        }
    }

	function setupFilters() {
		const filterBtns = document.querySelectorAll('.filter-btn');
		const charCards = document.querySelectorAll('.char-card');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter');
				
				// Update buttons
				filterBtns.forEach(b => {
					b.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-lg');
					b.classList.add('bg-white', 'dark:bg-slate-900', 'border', 'slate-200', 'dark:border-slate-800', 'text-slate-500');
				});
				btn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-lg');
				btn.classList.remove('bg-white', 'dark:bg-slate-900', 'border', 'slate-200', 'dark:border-slate-800', 'text-slate-500');

				// Update characters
				charCards.forEach(card => {
					if (filter === 'all' || card.getAttribute('data-member') === filter) {
						card.style.display = 'block';
						setTimeout(() => card.style.opacity = '1', 10);
					} else {
						card.style.opacity = '0';
						setTimeout(() => card.style.display = 'none', 300);
					}
				});

                // Reset visible count on filter
                visibleCount = 10;
                updateVisibility();
			});
		});
	}

    function setupLoadMore() {
        const btn = document.getElementById('loadMoreBtn');
        btn.addEventListener('click', () => {
            visibleCount += increment;
            updateVisibility();
        });
    }

    function setupAccordion() {
        document.querySelectorAll('.expand-trigger').forEach(trigger => {
            trigger.addEventListener('click', () => {
                const content = trigger.querySelector('.expandable-content');
                const label = trigger.querySelector('.expand-label span');
                const svg = trigger.querySelector('.expand-label svg');
                const isExpanded = content.classList.contains('opacity-100');
                
                if (isExpanded) {
                    content.style.maxHeight = '0';
                    content.classList.remove('opacity-100', 'pt-4');
                    content.classList.add('opacity-0');
                    label.textContent = 'Expand Analysis';
                    svg.style.transform = 'rotate(0deg)';
                } else {
                    content.style.maxHeight = '1000px';
                    content.classList.add('opacity-100', 'pt-4');
                    content.classList.remove('opacity-0');
                    label.textContent = 'Collapse Analysis';
                    svg.style.transform = 'rotate(180deg)';
                }
            });
        });
    }

	setupFilters();
    setupLoadMore();
    setupAccordion();
    updateVisibility();
</script>
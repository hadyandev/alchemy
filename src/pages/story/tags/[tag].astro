---
import BaseLayout from '../../layouts/BaseLayout.astro';
import storyData from '../../data/storymode.json';

export async function getStaticPaths() {
    const allTags = [...new Set(storyData.flatMap(post => post.tags))];
    return allTags.map(tag => ({
        params: { tag: tag.toLowerCase() },
        props: { tag, posts: storyData.filter(post => post.tags.includes(tag)) }
    }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag} | Story Mode`}>
    <div class="py-10 space-y-20">
        <header class="max-w-4xl">
            <a href="/story" class="text-xs font-black uppercase tracking-widest text-purple-500 hover:text-purple-600 transition-colors flex items-center gap-2 mb-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to Story Grimoire
            </a>
            <div class="w-16 h-1 bg-purple-600 mb-6"></div>
            <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-6 text-slate-900 dark:text-white uppercase">Stories Tagged: #{tag}</h1>
        </header>

        <div class="grid md:grid-cols-2 gap-8">
            {posts.map(post => (
                <a href={`/story/${post.slug}`} class="group">
                    <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-purple-500/50 transition-all h-full flex flex-col">
                        <div class="flex justify-between items-start mb-6">
                            <span class="px-2 py-0.5 rounded bg-purple-600 text-white text-[9px] font-black uppercase tracking-widest">{post.medium}</span>
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">{post.date}</span>
                        </div>
                        <h3 class="text-2xl font-black text-slate-900 dark:text-white uppercase leading-tight mb-4 group-hover:text-purple-500 transition-colors">
                            {post.title}
                        </h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-3 mb-8 italic leading-relaxed">
                            "{post.narrative}"
                        </p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</BaseLayout>
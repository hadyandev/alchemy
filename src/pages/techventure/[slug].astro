---
import BaseLayout from '../../layouts/BaseLayout.astro';
import techventureData from '../../data/techventure.json';

export async function getStaticPaths() {
    return techventureData
        .filter(p => p.status !== "Draft")
        .map(post => ({
            params: { slug: post.slug },
            props: { post }
        }));
}

const { post } = Astro.props;

function renderBlock(block) {
    const type = block.type;
    const content = block[type]?.rich_text;
    if (!content) return null;

    const text = content.map(t => {
        let classes = "";
        if (t.annotations.bold) classes += " font-bold";
        if (t.annotations.italic) classes += " italic";
        if (t.annotations.code) classes += " font-mono bg-slate-100 dark:bg-slate-800 px-1 rounded";
        
        return `<span class="${classes}">${t.plain_text}</span>`;
    }).join('');

    switch (type) {
        case 'heading_1': return `<h1 class="text-3xl font-black mt-12 mb-6 uppercase tracking-tight">${text}</h1>`;
        case 'heading_2': return `<h2 class="text-2xl font-bold mt-10 mb-4 uppercase tracking-tight text-blue-500">${text}</h2>`;
        case 'paragraph': return `<p class="mb-6 leading-relaxed text-slate-600 dark:text-slate-400">${text}</p>`;
        case 'bulleted_list_item': return `<li class="ml-6 mb-2 list-disc text-slate-600 dark:text-slate-400">${text}</li>`;
        case 'quote': return `<blockquote class="border-l-4 border-purple-500 pl-6 py-2 italic my-8 text-lg text-slate-700 dark:text-slate-300 bg-purple-50/30 dark:bg-purple-900/10 rounded-r-xl">${text}</blockquote>`;
        default: return null;
    }
}
---

<BaseLayout title={`${post.title} | Techventure`}>
    <article class="py-10 max-w-4xl mx-auto">
        <header class="mb-12">
            <a href="/techventure" class="text-xs font-black uppercase tracking-widest text-blue-500 hover:text-blue-600 transition-colors flex items-center gap-2 mb-12">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to Archive
            </a>
            
            <div class="space-y-8">
                <div class="flex flex-wrap items-center gap-3">
                    <a href={`/techventure/category/${post.category.toLowerCase().replace(/\s+/g, '-')}`} class="px-3 py-1 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest hover:bg-emerald-600 transition-colors">{post.category}</a>
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{post.date}</span>
                </div>

                <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-[0.9] mb-8">
                    {post.title}
                </h1>

                <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 pt-8 border-t border-slate-200 dark:border-slate-800">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-[10px] font-black italic">
                            {post.author[0]}
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">Alchemist</span>
                            <a href={`/authors/${post.author.toLowerCase()}`} class="text-sm font-bold text-slate-900 dark:text-white hover:text-blue-500 transition-colors">{post.author}</a>
                        </div>
                    </div>

                    {post.source && (
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 text-xs">
                                🔗
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">Source</span>
                                <span class="text-sm font-bold text-slate-700 dark:text-slate-300">{post.source}</span>
                            </div>
                        </div>
                    )}
                </div>
            </div>
            
            <div class="flex flex-wrap gap-2 mt-8">
                {post.tags.map(tag => (
                    <a href={`/techventure/tags/${tag.toLowerCase()}`} class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter hover:text-emerald-500 transition-colors px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800">#{tag}</a>
                ))}
            </div>

            {post.polish && (
                <div class="mt-12 p-8 rounded-3xl bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-900/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-amber-600 mb-3 block">Alchemical Insight</span>
                    <p class="text-sm text-amber-800 dark:text-amber-400 italic leading-relaxed">"{post.polish}"</p>
                </div>
            )}
        </header>

        <div class="prose dark:prose-invert max-w-none bg-white dark:bg-slate-900 p-8 md:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
            {post.content.map(block => (
                <div set:html={renderBlock(block)} />
            ))}
        </div>
    </article>
</BaseLayout>
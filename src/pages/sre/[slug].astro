---
import BaseLayout from '../../layouts/BaseLayout.astro';
import sreData from '../../data/sre.json';

export async function getStaticPaths() {
    return sreData
        .filter(p => p.status !== "Draft")
        .map(post => ({
            params: { slug: post.id },
            props: { post }
        }));
}

const { post } = Astro.props;

function renderBlock(block) {
    const type = block.type;
    const content = block[type]?.rich_text;
    if (!content) return null;

    const text = content.map(t => {
        let classes = "";
        if (t.annotations.bold) classes += " font-bold";
        if (t.annotations.italic) classes += " italic";
        if (t.annotations.code) classes += " font-mono bg-slate-100 dark:bg-slate-800 px-1 rounded";
        
        return `<span class="${classes}">${t.plain_text}</span>`;
    }).join('');

    switch (type) {
        case 'heading_1': return `<h1 class="text-3xl font-black mt-12 mb-6 uppercase tracking-tight">${text}</h1>`;
        case 'heading_2': return `<h2 class="text-2xl font-bold mt-10 mb-4 uppercase tracking-tight text-red-500">${text}</h2>`;
        case 'paragraph': return `<p class="mb-6 leading-relaxed text-slate-600 dark:text-slate-400">${text}</p>`;
        case 'bulleted_list_item': return `<li class="ml-6 mb-2 list-disc text-slate-600 dark:text-slate-400">${text}</li>`;
        case 'quote': return `<blockquote class="border-l-4 border-red-500 pl-6 py-2 italic my-8 text-lg text-slate-700 dark:text-slate-300 bg-red-50/30 dark:bg-red-900/10 rounded-r-xl">${text}</blockquote>`;
        default: return null;
    }
}
---

<BaseLayout title={`${post.title} | SRE Repository`}>
    <article class="py-10 max-w-4xl mx-auto">
        <header class="mb-12">
            <a href="/sre" class="text-xs font-black uppercase tracking-widest text-red-500 hover:text-red-600 transition-colors flex items-center gap-2 mb-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to Repository
            </a>
            
            <div class="flex gap-2 mb-6">
                <span class={`px-2 py-0.5 rounded text-white text-[10px] font-black uppercase tracking-widest ${
                    post.severity === 'Critical' ? 'bg-red-600' : 
                    post.severity === 'High' ? 'bg-orange-500' : 
                    post.severity === 'Medium' ? 'bg-yellow-500 text-slate-900' : 
                    'bg-blue-500'
                }`}>
                    {post.severity}
                </span>
                <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 text-[10px] font-black uppercase tracking-widest">{post.date}</span>
                <span class="px-2 py-0.5 rounded bg-red-50 dark:bg-red-900/10 text-red-600 dark:text-red-400 text-[10px] font-black uppercase tracking-widest border border-red-100 dark:border-red-800/50">{post.protocol}</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white uppercase tracking-tight leading-none mb-8">
                {post.title}
            </h1>
            
            <div class="flex flex-wrap gap-2 mb-8">
                {post.tags.map(tag => (
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-tighter">#{tag}</span>
                ))}
            </div>

            {post.polish && (
                <div class="p-8 rounded-3xl bg-red-50 dark:bg-red-900/10 border border-red-100 dark:border-red-900/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-red-600 mb-3 block">Post-Mortem Insight</span>
                    <p class="text-sm text-red-800 dark:text-red-400 italic leading-relaxed">"{post.polish}"</p>
                </div>
            )}
        </header>

        <div class="prose dark:prose-invert max-w-none">
            <div class="bg-white dark:bg-slate-900 p-8 md:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
                {post.content.map(block => (
                    <div set:html={renderBlock(block)} />
                ))}
            </div>
        </div>
    </article>
</BaseLayout>
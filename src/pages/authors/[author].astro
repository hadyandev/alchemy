---
import BaseLayout from '../../layouts/BaseLayout.astro';
import statsData from '../data/stats.json';
import techData from '../data/techventure.json';
import sreData from '../data/sre.json';
import storyData from '../data/storymode.json';

export async function getStaticPaths() {
    const authors = statsData.filter(s => s.class === "The Master" || s.class === "The Scribe");
    return authors.map(author => {
        const name = author.class === "The Master" ? "Hadyan" : "Al-Z";
        return {
            params: { author: name.toLowerCase() },
            props: { author: name, stats: author }
        };
    });
}

const { author, stats } = Astro.props;

const allPosts = [
    ...techData.map(p => ({ ...p, type: 'Techventure', color: 'emerald', link: `/techventure/${p.slug}` })),
    ...sreData.map(p => ({ ...p, type: 'SRE', color: 'red', link: `/sre/${p.slug}` })),
    ...storyData.map(p => ({ ...p, type: 'Story Mode', color: 'purple', link: `/story/${p.slug}` }))
].filter(p => p.author === author).sort((a, b) => new Date(b.date) - new Date(a.date));

const avatar = author === "Hadyan" ? "/hoshi.png" : "/alz-avatar.jpg";
const isPng = author === "Hadyan";
---

<BaseLayout title={`Alchemist: ${author} | The Atelier`}>
    <div class="py-10 space-y-16">
        <header class="relative p-8 md:p-12 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/5 blur-[100px] -mr-32 -mt-32"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
                <div class={`w-32 h-32 md:w-48 md:h-48 rounded-3xl flex items-center justify-center shadow-2xl shrink-0 overflow-hidden border ${isPng ? 'bg-black dark:bg-white border-slate-800' : 'bg-black border-slate-800'}`}>
                    <img src={avatar} alt={author} class={`w-full h-full ${isPng ? 'object-contain p-4 dark:invert invert-0 scale-125' : 'object-cover'}`} />
                </div>
                
                <div class="text-center md:text-left space-y-4">
                    <div class="space-y-1">
                        <span class="text-xs font-black uppercase tracking-[0.3em] text-blue-500">The Alchemist Contributor</span>
                        <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white uppercase tracking-tighter">{author === "Hadyan" ? "Hadyan Ahmad" : "Alkhawarizmi Zaid"}</h1>
                    </div>
                    
                    <div class="flex flex-wrap justify-center md:justify-start gap-4 text-xs font-bold uppercase tracking-widest text-slate-400">
                        <span class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-blue-500"></span> Level {stats.level}
                        </span>
                        <span class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-purple-500"></span> {stats.wisdom} Wisdom
                        </span>
                        <span class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> {stats.exp} EXP
                        </span>
                    </div>
                </div>
            </div>
        </header>

        <section class="space-y-8">
            <div class="flex items-center gap-4 mb-8">
                <h2 class="text-xl font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white shrink-0">Contributions Archive</h2>
                <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                <span class="text-xs font-bold text-slate-400">{allPosts.length} Artifacts Found</span>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                {allPosts.map(post => (
                    <a href={post.link} class="group">
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-blue-500/50 transition-all flex flex-col h-full shadow-sm">
                            <div class="flex justify-between items-start mb-4">
                                <span class={`px-2 py-0.5 rounded text-white text-[9px] font-black uppercase tracking-widest bg-${post.color}-500`}>{post.type}</span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">{post.date}</span>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 dark:text-white uppercase leading-tight mb-4 group-hover:text-blue-500 transition-colors">
                                {post.title}
                            </h3>
                            <div class="mt-auto flex justify-between items-center pt-4 border-t border-slate-50 dark:border-slate-800">
                                <span class="text-[10px] font-bold text-slate-400">#{post.tags[0]}</span>
                                <span class="text-[10px] font-black uppercase tracking-widest text-blue-500 flex items-center gap-1">
                                    Singkap <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </div>
</BaseLayout>
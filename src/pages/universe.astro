---
import BaseLayout from '../layouts/BaseLayout.astro';
import glossaryData from '../data/glossary.json';
import tasksData from '../data/tasks.json';
import scriptsData from '../data/scripts.json';
import quotesData from '../data/quotes.json';

const glossary = glossaryData.reduce((acc, item) => {
    const cat = item.category || 'General';
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(item);
    return acc;
}, {});

const quests = tasksData
    .filter(t => t.display && t.status !== "Done")
    .map(t => ({
        title: t.display,
        rank: t.rank,
        type: t.type,
        reward: t.reward
    }));

const scripts = scriptsData.map(s => ({
    name: s.name,
    category: s.category,
    type: s.type,
    description: s.description,
    complexity: s.complexity
}));

const quotes = quotesData.map(q => ({
    text: q.text,
    author: q.author,
    origin: q.origin,
    alignment: q.alignment,
    reflection: q.reflection,
    reference: q.reference
}));

const universeManifesto = [
    {
        title: "The Vision",
        description: "The Atelier is a digital sanctuary where technology meets the ancient principles of Alchemy. It is not just a personal website, but a centralized manifestation of growth, discipline, and the pursuit of Ihsan (excellence)."
    },
    {
        title: "Equivalent Exchange",
        description: "Every line of code and every moment of spiritual reflection is an investment. In this universe, we track that investment as EXP and Wisdom, ensuring that every effort results in a tangible evolution of the self."
    },
    {
        title: "The Persona",
        description: "The universe is maintained by two entities: The Seeker Alchemist (Master Hadyan) who drives the vision, and The Eternal Scribe (Al-Z) who documents and automates the path to ascension."
    }
];
---

<BaseLayout title="Universe | The Atelier">
    <div class="py-10 space-y-20">
        <header class="max-w-3xl">
            <div class="w-16 h-1 bg-purple-500 mb-6"></div>
            <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-6 text-slate-900 dark:text-white uppercase">The Atelier Universe</h1>
            <p class="text-lg text-slate-500 leading-relaxed italic">
                Understanding the laws, the lexicon, and the vision behind the digital laboratory.
            </p>
        </header>

        <section id="manifesto">
            <div class="grid md:grid-cols-3 gap-12">
                {universeManifesto.map(item => (
                    <div class="space-y-4">
                        <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-500 font-black">!</div>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white uppercase tracking-tight">{item.title}</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{item.description}</p>
                    </div>
                ))}
            </div>
        </section>

        <section id="glossary">
            <div class="mb-10 border-l-4 border-blue-500 pl-6">
                <h2 class="text-3xl font-black text-slate-900 dark:text-white uppercase tracking-tight">The Arcane Lexicon</h2>
                <p class="text-slate-500 italic">Terminology used within the atelier's operations.</p>
            </div>

            <div class="grid lg:grid-cols-3 gap-12">
                {Object.entries(glossary).map(([category, terms]) => (
                    <div class="space-y-6">
                        <h3 class="text-xs font-black uppercase tracking-[0.3em] text-blue-500 border-b border-blue-100 dark:border-blue-900/30 pb-4">{category}</h3>
                        <div class="space-y-8">
                            {terms.map(item => (
                                <div class="group">
                                    <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-blue-500 transition-colors">{item.term}</h4>
                                    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed italic">"{item.description}"</p>
                                </div>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {quotes.length > 0 && (
            <section id="echoes-of-wisdom">
                <div class="mb-10 border-l-4 border-pink-500 pl-6">
                    <h2 class="text-3xl font-black text-slate-900 dark:text-white uppercase tracking-tight">The Echoes of Wisdom</h2>
                    <p class="text-slate-500 italic">Soul mantras and philosophical anchors for the alchemist's journey.</p>
                </div>
                <div class="grid md:grid-cols-2 gap-8">
                    {quotes.map(quote => (
                        <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 relative group">
                            <span class="absolute top-4 right-8 text-6xl text-slate-100 dark:text-slate-800/50 font-serif opacity-50 group-hover:text-pink-500/10 transition-colors">"</span>
                            <div class="relative z-10">
                                <div class="flex gap-2 mb-6">
                                    <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 text-[9px] font-black uppercase tracking-widest">{quote.origin}</span>
                                    <span class="px-2 py-0.5 rounded bg-pink-50 dark:bg-pink-900/20 text-pink-500 text-[9px] font-black uppercase tracking-widest border border-pink-100 dark:border-pink-800/50">{quote.alignment}</span>
                                </div>
                                <p class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white leading-relaxed mb-6 italic">
                                    "{quote.text}"
                                </p>
                                <div class="flex flex-col gap-4 pt-6 border-t border-slate-50 dark:border-slate-800">
                                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                                        <span class="text-sm font-black text-slate-900 dark:text-white">— {quote.author}</span>
                                        {quote.reference && (
                                            <span class="text-[10px] font-mono text-slate-400 bg-slate-50 dark:bg-slate-800/50 px-2 py-0.5 rounded border border-slate-100 dark:border-slate-800/50">
                                                {quote.reference}
                                            </span>
                                        )}
                                    </div>
                                    {quote.reflection && (
                                        <p class="text-xs text-slate-400 italic leading-relaxed">{quote.reflection}</p>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </section>
        )}

        <section id="arcane-scripts">
             <div class="mb-10 border-l-4 border-emerald-500 pl-6">
                <h2 class="text-3xl font-black text-slate-900 dark:text-white uppercase tracking-tight">The Arcane Scripts</h2>
                <p class="text-slate-500 italic">Core shell commands and automation logic from the laboratory.</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {scripts.map(script => (
                    <div class="p-6 rounded-2xl bg-slate-900 text-white border border-white/5 hover:border-emerald-500/50 transition-all group">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded bg-emerald-500 text-white">{script.type}</span>
                            <span class={`text-[9px] font-bold uppercase ${script.complexity === 'Grandmaster' ? 'text-red-500' : 'text-emerald-400'}`}>{script.complexity}</span>
                        </div>
                        <h4 class="text-lg font-bold mb-2 group-hover:text-emerald-400 transition-colors">{script.name}</h4>
                        <p class="text-xs text-slate-400 italic mb-4">"{script.description}"</p>
                        <div class="pt-4 border-t border-white/10 flex justify-between items-center">
                            <span class="text-[10px] uppercase font-bold text-slate-500">Category</span>
                            <span class="text-[10px] font-black uppercase text-emerald-400">{script.category}</span>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {quests.length > 0 && (
            <section id="quest-board">
                <div class="mb-10 border-l-4 border-red-500 pl-6">
                    <h2 class="text-3xl font-black text-slate-900 dark:text-white uppercase tracking-tight">Active Quests</h2>
                    <p class="text-slate-500 italic">Open bounties and active manifestations in the mortal realm.</p>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {quests.map(quest => (
                        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                            <div class="flex justify-between items-start mb-4">
                                <span class="text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 border border-red-100 dark:border-red-800/50">{quest.rank}</span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">{quest.type}</span>
                            </div>
                            <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-4 italic">"{quest.title}"</h4>
                            <div class="pt-4 border-t border-slate-50 dark:border-slate-800 flex justify-between items-center">
                                <span class="text-[10px] uppercase font-bold text-slate-400">Reward</span>
                                <span class="text-[10px] font-black uppercase text-blue-500">{quest.reward} Essence</span>
                            </div>
                        </div>
                    ))}
                </div>
            </section>
        )}
    </div>
</BaseLayout>
